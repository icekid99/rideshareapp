# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ridezw_user:change_me@db:5432/ridezw_db

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# ── S3 / Storage ─────────────────────────────────────────────────────────────
UPLOAD_BUCKET=ridezw-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
# S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com  # for DigitalOcean Spaces
# CDN_BASE_URL=https://cdn.ridezw.app

# ── Payment Gateways (also in app_config DB table) ───────────────────────────
# PAYNOW_INTEGRATION_ID=
# PAYNOW_INTEGRATION_KEY=
# ECOCASH_MERCHANT_CODE=
# ECOCASH_MERCHANT_PIN=
# ECOCASH_API_URL=https://api.ecocash.co.zw/transactions/v1
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── AI Verification ───────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# AI_VERIFY_PROVIDER=openai   # or gemini

# ── Maps ──────────────────────────────────────────────────────────────────────
# GOOGLE_MAPS_API_KEY=...

# ── Misc ──────────────────────────────────────────────────────────────────────
